# ============================================
# FraudLens AI — Environment Configuration
# ============================================

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fraudlens
DB_ECHO=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# Redis (optional - for caching/pub-sub)
REDIS_URL=redis://localhost:6379/0

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# AI Assistant (optional - leave empty for rule-based assistant)
AI_API_KEY=

# Risk Engine Weights (0-1, must sum to 1.0)
RISK_WEIGHT_ML=0.35
RISK_WEIGHT_ANOMALY=0.25
RISK_WEIGHT_BEHAVIOR=0.25
RISK_WEIGHT_RULES=0.15

# Risk Thresholds
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=60
RISK_THRESHOLD_HIGH=80

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
