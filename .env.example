# ============================================
# FraudLens AI — Environment Configuration
# Copy this file to .env and fill in values.
# NEVER commit .env to Git.
# ============================================

# ---- Database ----
# For local dev with SQLite (zero config):
DATABASE_URL=sqlite:///./fraudlens.db
# For PostgreSQL (production / Render PostgreSQL add-on):
# DATABASE_URL=postgresql://user:password@host:5432/fraudlens
DB_ECHO=false

# ---- JWT Authentication ----
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# ---- Redis (optional - leave empty to disable) ----
# REDIS_URL=redis://localhost:6379/0

# ---- Server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Frontend URL (used for CORS) ----
# Local dev:
FRONTEND_URL=http://localhost:5173
# After deploying frontend to Vercel, update to your actual URL:
# FRONTEND_URL=https://your-app-name.vercel.app

# ---- AI Copilot (optional) ----
# Leave empty to use the built-in rule-based copilot.
# Set to a Gemini or OpenAI API key to enable generative responses.
AI_API_KEY=

# ---- ML Risk Engine Weights (must sum to 1.0) ----
RISK_WEIGHT_ML=0.35
RISK_WEIGHT_ANOMALY=0.25
RISK_WEIGHT_BEHAVIOR=0.25
RISK_WEIGHT_RULES=0.15

# ---- Risk Score Thresholds ----
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=70
RISK_THRESHOLD_HIGH=85

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- Logging ----
LOG_LEVEL=INFO
